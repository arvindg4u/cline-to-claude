# Cline-to-Claude Proxy — copy to .env and fill in (never commit .env)
#
# Cline talks OpenAI chat/completions; this proxy translates that to the
# Anthropic Messages API, so any Anthropic-wire upstream works.
#
# --- Upstream credential (required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Upstream base URL: api.anthropic.com, an Anthropic-compatible gateway, or a
# local Anthropic-wire proxy (e.g. claude-code-proxy on 127.0.0.1:4013).
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Use 'bearer' when the upstream wants Authorization: Bearer instead of x-api-key.
# ANTHROPIC_AUTH_MODE=x-api-key
# ANTHROPIC_AUTH_TOKEN=your-oauth-token
# ANTHROPIC_VERSION=2023-06-01
# ANTHROPIC_BETA=prompt-caching-2024-07-31

# --- Upstream model mapping ---
# Requests are routed by name class: opus->BIG, sonnet->MIDDLE, haiku->SMALL,
# anything else->DEFAULT_MODEL, unless MODEL_MAP names it exactly.
BIG_MODEL=claude-opus-4-1
MIDDLE_MODEL=claude-sonnet-4-5
SMALL_MODEL=claude-haiku-4-5
DEFAULT_MODEL=claude-sonnet-4-5
# MODEL_MAP=fast=claude-haiku-4-5,smart=claude-opus-4-1
# Forward unknown model ids unchanged (useful for multi-vendor gateways).
# PASSTHROUGH_UNKNOWN_MODELS=false

# --- Client auth ---
# Shared secret Cline must send as its API key. Unset = accept anything
# (fine for a loopback-only proxy).
# CLIENT_API_KEY=proxy

# --- Extended thinking ---
# Base budget in tokens, scaled by the reasoning effort Cline reports.
# 0 disables thinking translation entirely.
THINKING_BUDGET_TOKENS=0
DEFAULT_MAX_TOKENS=8192
MAX_TOKENS_LIMIT=128000
MIN_TOKENS_LIMIT=100

# --- Server ---
HOST=127.0.0.1
PORT=4014
LOG_LEVEL=INFO
REQUEST_TIMEOUT=180
MAX_RETRIES=2
# SSE keepalive seconds; comment frames keep idle streams alive during thinking.
STREAM_KEEPALIVE_SECS=15
